<?xml version="1.0" encoding="utf-8"?>
<!-- Design system: type scale (docs/design-system.md). Only the size lives here; colour, weight and
     letter spacing stay on the view, so applying a style never changes anything else on screen. -->
<resources>
    <!-- Programme details title (TCL fragment_epgdetail_pro, 40sp): above the approved scale. -->
    <style name="TextAppearance.Tcl.Hero" parent="">
        <item name="android:textSize">40sp</item>
    </style>
    <style name="TextAppearance.Tcl.Display" parent="">
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TextAppearance.Tcl.Title" parent="">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TextAppearance.Tcl.Headline" parent="">
        <item name="android:textSize">19sp</item>
    </style>
    <style name="TextAppearance.Tcl.Body" parent="">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.Tcl.Label" parent="">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.Tcl.Caption" parent="">
        <item name="android:textSize">12sp</item>
    </style>
</resources>
