    <!-- Icons. -->
    <dimen name="tcl_icon_small">16dp</dimen>
    <dimen name="tcl_icon_rail">18dp</dimen>

    <!-- TclRail (TCL item_channel_type): 58dp column, 42dp items, icon at 15/12dp. -->
    <dimen name="tcl_rail_width">58dp</dimen>
    <dimen name="tcl_rail_padding_end">25dp</dimen>
    <dimen name="tcl_rail_item_height">42dp</dimen>
    <dimen name="tcl_rail_icon_margin_start">15dp</dimen>

    <!-- TclPanel: channel column next to the rail. -->
    <dimen name="tcl_panel_width">280dp</dimen>

    <!-- TclChannelRow (TCL item_channel): 68dp, logo at 20/21dp, text at 78dp, second line at 36dp. -->
    <dimen name="tcl_channel_row_height">68dp</dimen>
