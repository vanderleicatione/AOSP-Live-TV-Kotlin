    <dimen name="tcl_option_row_icon_margin_start">13dp</dimen>
    <dimen name="tcl_option_row_text_margin_start">23dp</dimen>

    <!-- Rail: unselected categories at 60% (TCL "withalpha"). -->
    <item name="tcl_alpha_unselected" format="float" type="dimen">0.6</item>
</resources>
