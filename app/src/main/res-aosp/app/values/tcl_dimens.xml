<?xml version="1.0" encoding="utf-8"?>
<!-- Design system: size tokens (docs/design-system.md). Spacing is a 4dp scale; the component sizes are
     TCL Live TV's own (com.tcl.tv layouts), kept exactly as they are on screen. -->
<resources>
    <!-- Spacing (4dp scale). -->
    <dimen name="tcl_space_4">4dp</dimen>
    <dimen name="tcl_space_8">8dp</dimen>
    <dimen name="tcl_space_12">12dp</dimen>
    <dimen name="tcl_space_16">16dp</dimen>
    <dimen name="tcl_space_20">20dp</dimen>
    <dimen name="tcl_space_24">24dp</dimen>
    <dimen name="tcl_space_32">32dp</dimen>
    <dimen name="tcl_divider">1px</dimen>
    <dimen name="tcl_divider_overlap">-1px</dimen>

    <!-- Corners. -->
    <dimen name="tcl_radius_cell">6dp</dimen>
    <dimen name="tcl_radius_panel">8dp</dimen>
    <dimen name="tcl_radius_logo">4dp</dimen>
    <dimen name="tcl_radius_chip">21dp</dimen>
    <dimen name="tcl_radius_progress">1dp</dimen>

    <!-- TclLogoCard: small (list, banner neighbours) and large (banner card, programme details). -->
