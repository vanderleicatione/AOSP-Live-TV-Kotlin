<!-- Options side panel (1.5b): TclPanel on the right, no coloured header. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/side_panel"
    style="@style/Widget.Tcl.Panel.Side"
    android:elevation="@dimen/side_panel_elevation"
    android:translationX="@dimen/side_panel_enter_offset_x"
    android:alpha="0.0"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/side_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
