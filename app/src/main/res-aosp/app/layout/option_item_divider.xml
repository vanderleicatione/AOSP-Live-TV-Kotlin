<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false">

    <View
        android:id="@+id/divider_line"
        style="@style/Widget.Tcl.OptionRow.Divider"
        android:layout_alignParentTop="true" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider_line"
        android:layout_alignParentStart="true"
        android:paddingStart="@dimen/tcl_space_16"
        android:paddingEnd="@dimen/tcl_space_16"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/tcl_color_text_tertiary"
        android:textAppearance="@style/TextAppearance.Tcl.Label" />

</RelativeLayout>
