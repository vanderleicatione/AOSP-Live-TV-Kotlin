<?xml version="1.0" encoding="utf-8"?>
<!-- TclOptionRow: an option with its current value on the right, on the same light focus bar as the
     channel list (TCL dialog_universal_option_item: 40dp rows, 15dp icon at 13dp, text at 23dp).
     Base for the option screens of step 1.5b; not used yet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Tcl.OptionRow">

    <ImageView
        android:id="@+id/tcl_option_icon"
        android:layout_width="@dimen/tcl_option_row_icon"
        android:layout_height="@dimen/tcl_option_row_icon"
        android:layout_marginStart="@dimen/tcl_option_row_icon_margin_start"
        android:duplicateParentState="true"
        android:tint="@color/tcl_channel_type_icon"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tcl_option_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/tcl_option_row_text_margin_start"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/tcl_channel_list_primary_text"
        android:textAppearance="@style/TextAppearance.Tcl.Body" />

    <TextView
        android:id="@+id/tcl_option_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tcl_space_12"
        android:layout_marginEnd="@dimen/tcl_space_20"
        android:duplicateParentState="true"
        android:singleLine="true"
        android:textColor="@color/tcl_channel_list_secondary_text"
        android:textAppearance="@style/TextAppearance.Tcl.Label" />
</LinearLayout>
