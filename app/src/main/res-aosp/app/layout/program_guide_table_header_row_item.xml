<!-- Half-hour mark like TCL's epg_pro_time_item_layout: a 2x12dp tick at the start of the slot and the
     time 8dp after it. Selected = the slot containing now. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/program_guide_table_header_row_height"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:layout_width="@dimen/tcl_epg_tick_width"
        android:layout_height="@dimen/tcl_epg_tick_height"
        android:background="@color/tcl_epg_time_tick"
        android:duplicateParentState="true" />

    <TextView
        android:id="@+id/time"
        android:layout_width="@dimen/tcl_epg_time_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tcl_space_8"
        android:duplicateParentState="true"
        android:singleLine="true"
        android:textColor="@color/tcl_epg_time_text"
        android:textAppearance="@style/TextAppearance.Tcl.Label" />
</LinearLayout>
