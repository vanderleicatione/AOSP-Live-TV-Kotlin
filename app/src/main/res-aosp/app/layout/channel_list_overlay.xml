<?xml version="1.0" encoding="utf-8"?>
<!-- Left channel list, laid out like TCL Live TV's activity_channellist: 58dp category rail (#E1000000),
     a 1px divider, then the 280dp channel column (#CC0A0A0A). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channel_list_overlay"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:orientation="horizontal"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="match_parent"
        android:background="#E1000000">

        <LinearLayout
            android:id="@+id/channel_list_types"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingEnd="25dp"
            android:orientation="vertical" />
    </FrameLayout>

    <View
        android:layout_width="1px"
        android:layout_height="match_parent"
        android:background="#1FF0F0F2" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/channel_list_grid"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="#CC0A0A0A"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
