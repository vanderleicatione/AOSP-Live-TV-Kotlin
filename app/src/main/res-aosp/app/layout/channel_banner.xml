<!--  All info banners have the same id for use by TvTransitionManager. -->
<!-- Laid out like TCL Live TV's infobar_left_layout: a flush-left column with the previous channel
     (160x44dp at 124dp from the top), the current-channel card 20dp below (300x104dp: logo, then
     number 28sp / channel name 14sp / now playing 14sp) and the next channel 20dp below the card. -->
<com.android.tv.ui.ChannelBannerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scene_transition_common"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="start|top"
    android:layout_marginTop="@dimen/tcl_banner_margin_top" >

  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical" >

    <include android:id="@+id/channel_banner_previous"
        layout="@layout/tcl_channel_row_compact"
        android:layout_width="@dimen/tcl_channel_row_compact_width"
        android:layout_height="@dimen/tcl_channel_row_compact_height"
        android:layout_marginStart="@dimen/tcl_space_32"
        android:visibility="invisible" />

    <RelativeLayout android:id="@+id/channel_banner_view"
        android:layout_width="@dimen/channel_banner_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tcl_space_20"
        android:minHeight="@dimen/tcl_banner_min_height"
        android:background="@drawable/tcl_channel_banner_background"
        android:visibility="gone" >

        <ImageView android:id="@+id/channel_logo"
            style="@style/Widget.Tcl.LogoCard"
            android:layout_width="@dimen/tcl_logo_large_width"
            android:layout_height="@dimen/tcl_logo_large_height"
            android:layout_marginStart="@dimen/tcl_space_32"
            android:layout_marginTop="@dimen/tcl_banner_logo_top"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />

        <TextView android:id="@+id/channel_number"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tcl_banner_number_height"
            android:layout_marginStart="@dimen/tcl_banner_text_start"
            android:layout_marginEnd="@dimen/tcl_space_20"
            android:layout_marginTop="@dimen/channel_banner_channel_number_large_margin_top"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/tcl_color_text_primary"
            android:textSize="@dimen/channel_banner_channel_number_large_text_size" />

        <TextView android:id="@+id/channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tcl_banner_text_start"
            android:layout_marginEnd="@dimen/tcl_space_20"
            android:layout_marginTop="@dimen/tcl_banner_name_top"
            android:layout_alignParentStart="true"
            android:layout_below="@id/channel_number"
            android:singleLine="true"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:textColor="@color/tcl_color_text_primary"
            android:textAppearance="@style/TextAppearance.Tcl.Label" />

        <TextView android:id="@+id/program_text"
            android:layout_width="@dimen/channel_banner_program_description_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tcl_banner_text_start"
            android:layout_marginTop="@dimen/channel_banner_program_large_margin_top"
            android:layout_alignParentStart="true"
            android:layout_below="@id/channel_name"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:textColor="@color/tcl_color_text_primary"
            android:textSize="@dimen/channel_banner_program_large_text_size" />

        <!-- ChannelBannerView moves this via RelativeLayout params; zero-size so it never adds height. -->
        <Space android:id="@+id/anchor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="@dimen/channel_banner_anchor_one_line_y" />

        <!-- AOSP-only details the TCL banner doesn't show (time, progress, DVR, track meta, description).
             Kept so ChannelBannerView's bindings resolve; the gone parent keeps them hidden even when it
             toggles them visible. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" >

            <ImageView android:id="@+id/tvinput_logo"
                android:layout_width="@dimen/channel_banner_input_logo_size"
                android:layout_height="@dimen/channel_banner_input_logo_size" />

            <ImageView android:id="@+id/channel_signal_strength"
                android:layout_width="@dimen/channel_banner_input_logo_size"
                android:layout_height="@dimen/channel_banner_input_logo_size" />

            <TextView android:id="@+id/program_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView android:id="@+id/recording_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_recording_program" />

            <ProgressBar
                android:id="@+id/remaining_time"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progressDrawable="@drawable/progress_horizontal"
                android:indeterminate="false"
                android:max="100" />

            <include layout="@layout/program_track_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView android:id="@+id/program_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>

    </RelativeLayout>

    <include android:id="@+id/channel_banner_next"
        layout="@layout/tcl_channel_row_compact"
        android:layout_width="@dimen/tcl_channel_row_compact_width"
        android:layout_height="@dimen/tcl_channel_row_compact_height"
        android:layout_marginStart="@dimen/tcl_space_32"
        android:layout_marginTop="@dimen/tcl_space_20"
        android:visibility="invisible" />
  </LinearLayout>

</com.android.tv.ui.ChannelBannerView>
