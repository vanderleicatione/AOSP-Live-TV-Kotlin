<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Bugfix: TvInteractiveAppView ist erst ab Android 13 (API 33) vorhanden. Direkt im
  ~ activity_tv-Layout crasht das Inflaten auf älteren Geräten (ClassNotFoundException).
  ~ Deshalb hier ausgelagert und per ViewStub nur bei TvFeatures.hasTiaf() inflatet.
  -->
<android.media.tv.interactive.TvInteractiveAppView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_app_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent" />
