<!-- Laid out like TCL Live TV's fragment_epg_pro: the video stays visible behind black masks, a 58dp
     strip on the left (where TCL has its category rail), title and clock at 32dp from the top, details of
     the focused programme at 73dp, and the 6-row grid at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/program_guide"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:layout_width="@dimen/tcl_rail_width"
        android:layout_height="match_parent"
        android:background="@color/tcl_color_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/tcl_rail_width"
        android:background="@drawable/tcl_epg_left_mask" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/tcl_epg_top_mask_height"
        android:layout_marginStart="@dimen/tcl_rail_width"
        android:background="@drawable/tcl_epg_top_mask" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/tcl_epg_bottom_mask_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/tcl_rail_width"
        android:background="@drawable/tcl_epg_bottom_mask" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tcl_rail_width"
        android:layout_marginTop="@dimen/tcl_space_32"
        android:text="@string/tcl_epg_title"
        android:textColor="@color/tcl_color_text_soft"
        android:textAppearance="@style/TextAppearance.Tcl.Headline" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/tcl_space_32"
        android:layout_marginEnd="@dimen/tcl_space_32"
        android:format12Hour="EEE dd/MM/yyyy h:mm a"
        android:format24Hour="EEE dd/MM/yyyy HH:mm"
        android:textColor="@color/tcl_color_text_soft"
        android:textAppearance="@style/TextAppearance.Tcl.Body" />

    <LinearLayout
        android:layout_width="@dimen/tcl_epg_detail_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tcl_rail_width"
        android:layout_marginTop="@dimen/tcl_epg_detail_top"
        android:orientation="vertical">

        <TextView
            android:id="@+id/program_guide_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="2"
            android:textColor="@color/tcl_color_text_primary"
            android:textAppearance="@style/TextAppearance.Tcl.Title" />

        <TextView
            android:id="@+id/program_guide_detail_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tcl_space_8"
            android:singleLine="true"
            android:textColor="@color/tcl_color_text_secondary"
            android:textAppearance="@style/TextAppearance.Tcl.Label" />

        <LinearLayout
            android:id="@+id/program_guide_detail_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tcl_epg_detail_gap"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/program_guide_detail_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tcl_epg_detail_gap"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="2"
            android:textColor="@color/tcl_color_text_soft"
            android:textAppearance="@style/TextAppearance.Tcl.Headline" />
    </LinearLayout>

    <!-- AOSP genre panel: TCL has an icon rail here instead, so it is kept (ProgramGuide binds it) but hidden. -->
    <include layout="@layout/program_guide_side_panel" android:visibility="gone" />
    <include layout="@layout/program_guide_table" />

    <!-- TCL fragment_epgdetail_pro: programme details over the video. Opens with OK on a programme that is
         not on air; Back closes it. Focusable so the arrow keys stay here instead of moving the grid. -->
    <FrameLayout
        android:id="@+id/program_guide_detail_screen"
        style="@style/Widget.Tcl.Dialog"
        android:visibility="gone">

        <LinearLayout style="@style/Widget.Tcl.Dialog.Content">

            <TextView
                android:id="@+id/program_guide_detail_screen_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/tcl_color_text_secondary"
                android:textAppearance="@style/TextAppearance.Tcl.Body" />

            <ImageView
                android:id="@+id/program_guide_detail_screen_logo"
                style="@style/Widget.Tcl.LogoCard.Framed"
                android:layout_width="@dimen/tcl_logo_large_width"
                android:layout_height="@dimen/tcl_logo_large_height"
                android:layout_marginTop="@dimen/tcl_space_12"
                android:visibility="gone" />

            <TextView
                android:id="@+id/program_guide_detail_screen_title"
                android:layout_width="@dimen/tcl_dialog_title_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tcl_space_12"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:textColor="@color/tcl_color_text_primary"
                android:textAppearance="@style/TextAppearance.Tcl.Hero" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tcl_space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/program_guide_detail_screen_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tcl_color_text_secondary"
                    android:textAppearance="@style/TextAppearance.Tcl.Caption" />

                <ProgressBar
                    android:id="@+id/program_guide_detail_screen_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="@dimen/tcl_dialog_progress_width"
                    android:layout_height="@dimen/tcl_dialog_progress_height"
                    android:layout_marginStart="@dimen/tcl_dialog_progress_gap"
                    android:layout_marginEnd="@dimen/tcl_dialog_progress_gap"
                    android:max="10000"
                    android:progressDrawable="@drawable/tcl_epg_detail_progress" />

                <TextView
                    android:id="@+id/program_guide_detail_screen_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tcl_color_text_secondary"
                    android:textAppearance="@style/TextAppearance.Tcl.Caption" />

                <TextView
                    android:id="@+id/program_guide_detail_screen_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/tcl_space_12"
                    android:textColor="@color/tcl_color_text_secondary"
                    android:textAppearance="@style/TextAppearance.Tcl.Caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/program_guide_detail_screen_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tcl_space_20"
                android:orientation="horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/program_guide_detail_screen_desc"
                android:layout_width="@dimen/tcl_dialog_text_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tcl_space_20"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:lineHeight="@dimen/tcl_dialog_line_height"
                android:maxLines="6"
                android:textColor="@color/tcl_color_text_secondary"
                android:textAppearance="@style/TextAppearance.Tcl.Body" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
