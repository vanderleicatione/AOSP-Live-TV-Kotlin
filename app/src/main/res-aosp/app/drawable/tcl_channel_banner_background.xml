<?xml version="1.0" encoding="utf-8"?>
<!-- Replica of TCL Live TV's bg_focus_info: flush-left translucent card, only the right corners
     rounded, grey hairline on top/right/bottom (the left stroke is pushed off-screen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/tcl_banner_stroke_offset">
        <shape>
            <stroke android:width="@dimen/tcl_banner_stroke" android:color="@color/tcl_color_banner_stroke" />
            <corners android:topRightRadius="@dimen/tcl_radius_panel" android:bottomRightRadius="@dimen/tcl_radius_panel" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/tcl_color_surface_banner" />
            <corners android:topRightRadius="@dimen/tcl_radius_panel" android:bottomRightRadius="@dimen/tcl_radius_panel" />
        </shape>
    </item>
</layer-list>
