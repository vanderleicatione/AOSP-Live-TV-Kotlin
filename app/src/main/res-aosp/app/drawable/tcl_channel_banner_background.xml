<?xml version="1.0" encoding="utf-8"?>
<!-- Replica of TCL Live TV's bg_focus_info: flush-left translucent card, only the right corners
     rounded, grey hairline on top/right/bottom (the left stroke is pushed off-screen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-3dp">
        <shape>
            <stroke android:width="1dp" android:color="#B2999999" />
            <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#6618191D" />
            <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp" />
        </shape>
    </item>
</layer-list>
