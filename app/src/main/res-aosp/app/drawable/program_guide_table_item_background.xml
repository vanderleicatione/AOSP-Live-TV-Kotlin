<!-- TCL Live TV EPG programme cell (epg_pro_program_item_*_bg): 6dp corners, #F0F0F2 when focused,
     #1FF0F0F2 for the programme on air, #0FF0F0F2 otherwise. Inset so the 48dp row slot shows a 44dp cell
     with TCL's 4dp gaps. No progress overlay (TCL has none), so ProgramItemView finds no reverse_progress. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tv="http://schemas.android.com/apk/res-auto" >

    <item android:state_focused="true" >
        <inset android:insetRight="4dp" android:insetBottom="4dp">
            <shape>
                <solid android:color="#FFF0F0F2" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
    <item tv:state_current_program="true" >
        <inset android:insetRight="4dp" android:insetBottom="4dp">
            <shape>
                <solid android:color="#1FF0F0F2" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetRight="4dp" android:insetBottom="4dp">
            <shape>
                <solid android:color="#0FF0F0F2" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
</selector>
