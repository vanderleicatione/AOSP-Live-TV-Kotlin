<?xml version="1.0" encoding="utf-8"?>
<!-- TCL Live TV EPG channel cell (epg_pro_channel_item_*_bg): 6dp corners, #1FF0F0F2, #3DF0F0F2 on the
     row that has focus. Inset so the 48dp row slot shows a 44dp cell with TCL's 4dp row gap and 2dp gap
     before the programmes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetRight="@dimen/tcl_epg_cell_gap" android:insetBottom="@dimen/tcl_space_4">
            <shape>
                <solid android:color="@color/tcl_color_surface_cell_selected" />
                <corners android:radius="@dimen/tcl_radius_cell" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetRight="@dimen/tcl_epg_cell_gap" android:insetBottom="@dimen/tcl_space_4">
            <shape>
                <solid android:color="@color/tcl_color_surface_cell" />
                <corners android:radius="@dimen/tcl_radius_cell" />
            </shape>
        </inset>
    </item>
</selector>
