<?xml version="1.0" encoding="utf-8"?>
<!-- TCL epg_detail_seek_bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/tcl_color_progress_track" />
            <corners android:radius="@dimen/tcl_radius_progress" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="@color/tcl_color_progress" />
                <corners android:radius="@dimen/tcl_radius_progress" />
            </shape>
        </clip>
    </item>
</layer-list>
